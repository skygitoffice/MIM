<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MIM.Inventory.Mobile.Pages.VoidPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="註銷作業">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Entry Placeholder="註銷單號" Text="{Binding VoidNo}" />
            <Entry Placeholder="註銷原因" Text="{Binding Reason}" />

            <Label Text="註銷明細" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Items}" HeightRequest="180">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="8" Margin="0,4" BorderColor="#DDDDDD">
                            <Label Text="{Binding .}" />
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="送出" Command="{Binding SubmitCommand}" />
            <Label Text="{Binding StatusMessage}" TextColor="Gray" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
