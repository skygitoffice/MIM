diff --git a/mobile/MIM.Inventory.Mobile/MauiProgram.cs b/mobile/MIM.Inventory.Mobile/MauiProgram.cs
new file mode 100644
index 0000000000000000000000000000000000000000..a2502f09dd477c81b6fd7b8e3f9de118815f41f7
--- /dev/null
+++ b/mobile/MIM.Inventory.Mobile/MauiProgram.cs
@@ -0,0 +1,24 @@
+using MIM.Inventory.Mobile.Pages;
+using MIM.Inventory.Mobile.Services;
+using MIM.Inventory.Mobile.ViewModels;
+
+namespace MIM.Inventory.Mobile;
+
+public static class MauiProgram
+{
+    public static MauiApp CreateMauiApp()
+    {
+        var builder = MauiApp.CreateBuilder();
+        builder
+            .UseMauiApp<App>()
+            .ConfigureFonts(_ => { });
+
+        builder.Services.AddSingleton<AppShell>();
+        builder.Services.AddSingleton<MainPage>();
+        builder.Services.AddSingleton<MainViewModel>();
+        builder.Services.AddHttpClient<ApiService>();
+        builder.Services.AddSingleton<IScannerService, ScannerService>();
+
+        return builder.Build();
+    }
+}
